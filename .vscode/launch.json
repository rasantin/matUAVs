{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug matUAVs(windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/Debug/matUAVs.exe",
      "args": ["C_T20_R6.txt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug matUAVs (WSL / Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/matUAVs",
      "args": ["D_T30_R6.txt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
  }
  ]
}